# 1. Bloquea la ejecución automática de scripts de instalación (Pre/Postinstall)
# Mitiga malware que se ejecuta inmediatamente al descargar el paquete.
ignore-scripts=true

# 2. Deshabilita la resolución laxa de dependencias ("Phantoms")
# Nadie puede importar librerías que no estén declaradas en tu package.json.
hoist=false

# 3. Fuerza la validación estricta de la integridad del árbol de dependencias
# El comando de instalación fallará si alguien alteró el archivo lockfile manualmente.
frozen-lockfile=true

# 4. Asegura que las dependencias de pares (peer dependencies) coincidan estrictamente
# Evita que se instalen versiones incompatibles o comprometidas bajo el radar.
strict-peer-dependencies=true

# 5. No descarga paquetes que hayan sido publicados en las últimas 72 horas
# Bloquea paquetes publicados en las últimas 72 horas (72 * 60 = 4320)
minimum-release-age=4320

# 6. Bloquear sub-dependencias exóticas (evita que descarguen código de repositorios Git ocultos o URLs raras)
block-exotic-subdeps=true

# 7. Política de no-degradación de confianza (valida firmas digitales de procedencia)
trust-policy=no-downgrade
